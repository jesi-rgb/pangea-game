spec: v0.7

name: pangea

# Pinned: base-compat 15 (= latest since 2026-10-30) never finishes stopping,
# so scale-to-zero leaves instances stuck in "stopping" and unroutable.
runtime: base-compat:14

rootfs: ./Dockerfile

cmd: ["/usr/bin/bun", "run", "/app/build/index.js"]

env:
  HOST: "0.0.0.0"
  PORT: "3000"
